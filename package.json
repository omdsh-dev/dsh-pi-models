{
  "name": "dsh-pi-models",
  "version": "0.2.0",
  "description": "Project the providers, models, keys and thinking levels configured in pi's models.json into this DeepSeek Harness model picker.",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pi",
    "pi-coding-agent",
    "llm",
    "models"
  ],
  "license": "MIT",
  "author": "cyzlmh",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-pi-models.git"
  },
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-pi-models/issues"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-pi-models",
  "publishConfig": {
    "access": "public"
  }
}

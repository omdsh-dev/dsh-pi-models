{
  "name": "dsh-pi-models",
  "version": "0.1.0",
  "description": "Project the providers, models, keys and thinking levels configured in pi's models.json into this DeepSeek Harness model picker.",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pi",
    "pi-coding-agent",
    "llm",
    "models"
  ],
  "license": "MIT",
  "author": "cyzlmh",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-pi-models.git"
  },
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-pi-models/issues"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-pi-models",
  "publishConfig": {
    "access": "public"
  }
}
